+inline std::optional<Id> sameTermPhysicalId(
+    const LocalVocabEntry& entry, const EvaluationContext* context) {
+  return xpod::qlever::physicalLiteralOrIriIdFromContext(
+      context->_qec, entry.asLiteralOrIri());
+}
+
+inline std::optional<LocalVocabEntry> sameTermEntryForId(
+    const Id& id, const EvaluationContext* context) {
+  if (context == nullptr) {
+    return std::nullopt;
+  }
+  if (auto physicalEntry = xpod::qlever::physicalValueIdEntry(
+          id, context->_qec.xpodPhysicalIndex(),
+          context->_qec.getLocalVocabContext());
+      physicalEntry.has_value()) {
+    return physicalEntry;
+  }
+  return xpod::qlever::qleverValueIdEntry(
+      id, context->_qec.getIndex(), context->_localVocab,
+      context->_qec.getLocalVocabContext());
+}
+
+inline LocalVocabEntry sameTermEntryForLocalVocab(
+    const LocalVocabEntry& entry, const EvaluationContext* context) {
+  if (auto physicalId = sameTermPhysicalId(entry, context);
+      physicalId.has_value()) {
+    if (auto physicalEntry = sameTermEntryForId(*physicalId, context);
+        physicalEntry.has_value()) {
+      return *physicalEntry;
+    }
+  }
+  return entry;
+}
+
+inline bool sameTermEntriesEqual(
+    const LocalVocabEntry& left, const LocalVocabEntry& right) {
+  return !(left < right) && !(right < left);
+}
+
+template <typename X, typename Y>
+Id sameTermIdentity(const X& x, const Y& y,
+                    const EvaluationContext* context) {
+  if constexpr (ad_utility::isSimilar<X, Id> &&
+                ad_utility::isSimilar<Y, Id>) {
+    if (x == Id::makeUndefined() || y == Id::makeUndefined()) {
+      return Id::makeUndefined();
+    }
+    if (x == y) {
+      return Id::makeFromBool(true);
+    }
+    const auto leftEntry = sameTermEntryForId(x, context);
+    const auto rightEntry = sameTermEntryForId(y, context);
+    if (leftEntry.has_value() || rightEntry.has_value()) {
+      return Id::makeFromBool(
+          leftEntry.has_value() && rightEntry.has_value() &&
+          sameTermEntriesEqual(*leftEntry, *rightEntry));
+    }
+    return Id::makeFromBool(false);
+  } else if constexpr (ad_utility::isSimilar<X, LocalVocabEntry> &&
+                       ad_utility::isSimilar<Y, LocalVocabEntry>) {
+    return Id::makeFromBool(sameTermEntriesEqual(
+        sameTermEntryForLocalVocab(x, context),
+        sameTermEntryForLocalVocab(y, context)));
+  } else if constexpr (ad_utility::isSimilar<X, Id> &&
+                       ad_utility::isSimilar<Y, LocalVocabEntry>) {
+    if (x == Id::makeUndefined()) {
+      return Id::makeUndefined();
+    }
+    const auto leftEntry = sameTermEntryForId(x, context);
+    if (!leftEntry.has_value()) {
+      return Id::makeFromBool(false);
+    }
+    return Id::makeFromBool(sameTermEntriesEqual(
+        *leftEntry, sameTermEntryForLocalVocab(y, context)));
+  } else if constexpr (ad_utility::isSimilar<X, LocalVocabEntry> &&
+                       ad_utility::isSimilar<Y, Id>) {
+    return sameTermIdentity(y, x, context);
+  } else {
+    return Id::makeFromBool(false);
+  }
+}
+
+CPP_template(typename S1, typename S2)(
+    requires SingleExpressionResult<S1> CPP_and SingleExpressionResult<S2>)
+    ExpressionResult evaluateSameTermExpression(
+        S1&& value1, S2&& value2, const EvaluationContext* context) {
+  auto resultSize =
+      sparqlExpression::detail::getResultSize(*context, value1, value2);
+  constexpr static bool resultIsConstant =
+      (isConstantResult<S1> && isConstantResult<S2>);
+  VectorWithMemoryLimit<Id> result{context->_allocator};
+  result.reserve(resultSize);
+
+  auto [generatorA, generatorB] =
+      getGenerators(AD_FWD(value1), AD_FWD(value2), resultSize, context);
+  auto itA = generatorA.begin();
+  auto itB = generatorB.begin();
+
+  for (size_t i = 0; i < resultSize; ++i) {
+    auto impl = [&](const auto& x, const auto& y) {
+      result.push_back(sameTermIdentity(x, y, context));
+    };
+    ad_utility::visitWithVariantsAndParameters(impl, *itA, *itB);
+    ++itA;
+    ++itB;
+    context->cancellationHandle_->throwIfCancelled();
+  }
+
+  if constexpr (resultIsConstant) {
+    AD_CONTRACT_CHECK(result.size() == 1);
+    return result[0];
+  } else {
+    return result;
+  }
+}
