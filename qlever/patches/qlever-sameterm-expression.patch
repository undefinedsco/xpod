+ExpressionResult SameTermExpression::evaluate(EvaluationContext* context) const {
+  auto resA = sameTermChildResult(children_[0], context);
+  auto resB = sameTermChildResult(children_[1], context);
+
+  auto visitor = [context](auto a, auto b) -> ExpressionResult {
+    return evaluateSameTermExpression(std::move(a), std::move(b), context);
+  };
+
+  return std::visit(visitor, std::move(resA), std::move(resB));
+}
+
+// _____________________________________________________________________________
+std::string SameTermExpression::getCacheKey(
+    const VariableToColumnMap& varColMap) const {
+  return absl::StrCat(typeid(*this).name(),
+                      children_[0]->getCacheKey(varColMap),
+                      children_[1]->getCacheKey(varColMap));
+}
+
