+SparqlExpression::Estimates SameTermExpression::getEstimatesForFilterExpression(
+    uint64_t inputSizeEstimate,
+    const std::optional<Variable>&) const {
+  const size_t sizeEstimate = inputSizeEstimate / reductionFactorEquals;
+  return {sizeEstimate, inputSizeEstimate + sizeEstimate};
+}
