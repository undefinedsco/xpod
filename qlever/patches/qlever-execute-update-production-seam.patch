 // _____________________________________________________________________________
+ExecuteUpdate::PreparedGraphUpdate ExecuteUpdate::prepareGraphUpdate(
+    const Index& index, const ParsedQuery& query, const Result& result,
+    const VariableToColumnMap& variableColumns,
+    const CancellationHandle& cancellationHandle,
+    ad_utility::timer::TimeTracer& tracer) {
+  UpdateMetadata metadata{};
+  auto [toInsert, toDelete] = computeGraphUpdateQuads(
+      index, query, result, variableColumns, cancellationHandle, metadata,
+      tracer);
+  std::array<const LocalVocab*, 3> localVocabs{
+      &result.localVocab(), &toInsert.localVocab_, &toDelete.localVocab_};
+  LocalVocab mergedLocalVocab = LocalVocab::merge(localVocabs);
+  return PreparedGraphUpdate{
+      std::move(toInsert.idTriples_), std::move(toDelete.idTriples_),
+      std::move(mergedLocalVocab), std::move(metadata)};
+}
