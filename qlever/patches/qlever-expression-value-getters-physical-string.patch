 using namespace sparqlExpression::detail;

+namespace {
+
+struct XpodPhysicalTermValue {
+  xpod_rdf_term_kind kind;
+  std::string value;
+  std::string datatype;
+  std::string language;
+};
+
+std::optional<std::string> xpodPhysicalTextForId(
+    Id id,
+    const sparqlExpression::EvaluationContext* context) {
+  if (context == nullptr ||
+      id.getDatatype() != Datatype::TextRecordIndex) {
+    return std::nullopt;
+  }
+  const xpod::qlever::XpodQleverPhysicalIndex* physicalIndex =
+      context->_qec.xpodPhysicalIndex();
+  if (physicalIndex == nullptr) {
+    return std::nullopt;
+  }
+  std::string content;
+  if (physicalIndex->resolveRetrievalPoint(
+          id.getTextRecordIndex().get(), content) != XPOD_RDF_STATUS_OK) {
+    return std::nullopt;
+  }
+  return content;
+}
+
+std::optional<XpodPhysicalTermValue> xpodPhysicalTermForId(
+    Id id,
+    const sparqlExpression::EvaluationContext* context) {
+  if (context == nullptr) {
+    return std::nullopt;
+  }
+  const xpod::qlever::XpodQleverPhysicalIndex* physicalIndex =
+      context->_qec.xpodPhysicalIndex();
+  if (physicalIndex == nullptr) {
+    return std::nullopt;
+  }
+  if (id.getDatatype() != Datatype::VocabIndex &&
+      id.getDatatype() != Datatype::BlankNodeIndex) {
+    return std::nullopt;
+  }
+
+  xpod_rdf_term_key key = 0;
+  if (physicalIndex->decodeQleverId(id.getBits(), key) !=
+      XPOD_RDF_STATUS_OK) {
+    return std::nullopt;
+  }
+
+  auto resolved = physicalIndex->resolveTerms(&key, 1);
+  if (resolved.status != XPOD_RDF_STATUS_OK ||
+      resolved.terms.size() != 1 ||
+      resolved.statuses.size() != 1 ||
+      resolved.statuses[0] != XPOD_RDF_STATUS_OK) {
+    return std::nullopt;
+  }
+
+  const auto& term = resolved.terms[0];
+  return XpodPhysicalTermValue{
+      term.kind,
+      std::string(term.value.data, term.value.size),
+      std::string(term.datatype_iri.data == nullptr ? "" : term.datatype_iri.data,
+                  term.datatype_iri.size),
+      std::string(term.language.data == nullptr ? "" : term.language.data,
+                  term.language.size)};
+}
+
+std::optional<LiteralOrIri> xpodPhysicalLiteralOrIriForId(
+    Id id,
+    const sparqlExpression::EvaluationContext* context) {
+  if (auto text = xpodPhysicalTextForId(id, context); text.has_value()) {
+    return LiteralOrIri::literalWithoutQuotes(*text);
+  }
+  auto term = xpodPhysicalTermForId(id, context);
+  if (!term.has_value()) {
+    return std::nullopt;
+  }
+  if (term->kind == XPOD_RDF_TERM_IRI) {
+    return LiteralOrIri::iriref(absl::StrFormat("<%s>", term->value));
+  }
+  if (term->kind != XPOD_RDF_TERM_LITERAL) {
+    return std::nullopt;
+  }
+  std::optional<std::variant<Iri, std::string>> descriptor;
+  if (!term->language.empty()) {
+    descriptor = term->language;
+  } else if (!term->datatype.empty()) {
+    descriptor = Iri::fromIrirefWithoutBrackets(term->datatype);
+  }
+  return LiteralOrIri::literalWithoutQuotes(term->value, std::move(descriptor));
+}
+
+std::optional<Id> xpodPhysicalValueIdForExpression(
+    Id id,
+    const sparqlExpression::EvaluationContext* context) {
+  if (context == nullptr) {
+    return std::nullopt;
+  }
+  auto physical = xpodPhysicalLiteralOrIriForId(id, context);
+  if (!physical.has_value()) {
+    return std::nullopt;
+  }
+  auto tripleComponent =
+      RdfStringParser<TurtleParser<TokenizerCtre>>::parseTripleObject(
+          physical->toStringRepresentation());
+  return tripleComponent.toValueIdIfNotString(
+      &context->_qec.getIndex().encodedIriManager());
+}
+
+std::optional<std::string> xpodPhysicalStringForId(
+    Id id,
+    const sparqlExpression::EvaluationContext* context) {
+  if (auto text = xpodPhysicalTextForId(id, context); text.has_value()) {
+    return text;
+  }
+  auto term = xpodPhysicalTermForId(id, context);
+  if (!term.has_value()) {
+    return std::nullopt;
+  }
+  return std::move(term->value);
+}
+
+std::optional<xpod_rdf_term_kind> xpodPhysicalTermKindForId(
+    Id id,
+    const sparqlExpression::EvaluationContext* context) {
+  auto term = xpodPhysicalTermForId(id, context);
+  if (!term.has_value()) {
+    return std::nullopt;
+  }
+  return term->kind;
+}
+
