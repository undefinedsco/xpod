 namespace sparqlExpression::detail {
+
+std::optional<bool> xpodPhysicalPrefixRegexMatch(
+    Id id, const EvaluationContext* context, std::string_view prefixRegex,
+    bool childIsStrExpression) {
+  if (context == nullptr) {
+    return std::nullopt;
+  }
+  const xpod::qlever::XpodQleverPhysicalIndex* physicalIndex =
+      context->_qec.xpodPhysicalIndex();
+  if (physicalIndex == nullptr) {
+    return std::nullopt;
+  }
+
+  xpod_rdf_term_key key = 0;
+  if (physicalIndex->decodeQleverId(id.getBits(), key) !=
+      XPOD_RDF_STATUS_OK) {
+    return std::nullopt;
+  }
+
+  auto resolved = physicalIndex->resolveTerms(&key, 1);
+  if (resolved.status != XPOD_RDF_STATUS_OK ||
+      resolved.terms.size() != 1 ||
+      resolved.statuses.size() != 1 ||
+      resolved.statuses[0] != XPOD_RDF_STATUS_OK) {
+    return std::nullopt;
+  }
+
+  const auto& term = resolved.terms[0];
+  if (!childIsStrExpression && term.kind != XPOD_RDF_TERM_LITERAL) {
+    return false;
+  }
+  std::string_view value(term.value.data, term.value.size);
+  return ql::starts_with(value, prefixRegex);
+}

