 using std::string;
 using LazyScanMetadata = CompressedRelationReader::LazyScanMetadata;
+
+uint32_t xpodIndexScanProjectedSlots(
+    const std::array<const TripleComponent* const, 3>& permutedTriple,
+    const std::vector<ColumnIndex>& additionalColumns,
+    Permutation::Enum permutation) {
+  const char* xpodPermutationSlots =
+      xpod::qlever::permutationSlots(permutation);
+  uint32_t xpodNeededSlots = 0;
+  for (size_t column = 0; column < permutedTriple.size(); ++column) {
+    if (permutedTriple[column]->isVariable()) {
+      xpodNeededSlots |= xpod::qlever::slotMask(xpodPermutationSlots[column]);
+    }
+  }
+  for (ColumnIndex additionalColumn : additionalColumns) {
+    if (additionalColumn == ADDITIONAL_COLUMN_GRAPH_ID) {
+      xpodNeededSlots |= XPOD_RDF_SLOT_GRAPH;
+    }
+  }
+  return xpodNeededSlots;
+}
+
+void xpodThrowPhysicalScanStatus(const char* operation,
+                                 xpod_rdf_status status) {
+  if (status == XPOD_RDF_STATUS_OK) {
+    return;
+  }
+  throw std::runtime_error(std::string{"Xpod physical "} + operation +
+                           " failed with status " +
+                           std::to_string(static_cast<int>(status)));
+}

