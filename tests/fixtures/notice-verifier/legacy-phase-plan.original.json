[
  [
    "install",
    [
      "bun",
      "install",
      "--frozen-lockfile"
    ],
    600
  ],
  [
    "declarations",
    [
      "bun",
      "-e",
      "import {exactVersion} from './scripts/independent-release-plan';import{modulePackageName,MODULE_API_VERSION}from './packages/xpod-cli/src/module-catalog';const name=modulePackageName('api',process.platform,process.arch);if(!exactVersion(process.argv[1])||!name)throw Error('Invalid API version/target');console.log(JSON.stringify({name,cliApiVersion:MODULE_API_VERSION}));",
      "1.0.0"
    ],
    60
  ],
  [
    "shared-packages",
    [
      "bun",
      "run",
      "build:packages"
    ],
    600
  ],
  [
    "dependency-state",
    [
      "bun",
      "scripts/check-dependency-state.ts"
    ],
    120
  ],
  [
    "api-build",
    [
      "bun",
      "run",
      "--cwd",
      "packages/xpod-api",
      "build"
    ],
    600
  ],
  [
    "native-inputs",
    [
      "bun",
      "/repo/packages/xpod-api/scripts/prepare-inngest-inputs.ts",
      "--target",
      "linux-arm64",
      "--out",
      "/out/originals"
    ],
    300
  ],
  [
    "stage",
    [
      "bun",
      "run",
      "--cwd",
      "packages/xpod-api",
      "stage",
      "/out/stage",
      "preview",
      "1.0.0"
    ],
    600
  ],
  [
    "native-material",
    [
      "bun",
      "/repo/packages/xpod-api/scripts/native-material.ts",
      "/out/stage",
      "/out/originals"
    ],
    300
  ],
  [
    "notices",
    [
      "bun",
      "/repo/packages/xpod-api/scripts/notice-material.ts",
      "/out/stage"
    ],
    300
  ],
  [
    "pack",
    [
      "bun",
      "run",
      "--cwd",
      "packages/xpod-api",
      "pack",
      "/out/stage",
      "/out/product.tgz"
    ],
    600
  ],
  [
    "pack-result",
    [
      "bun",
      "-e",
      "import {readFileSync} from 'node:fs';import {parseApiPackReceipt} from './scripts/collect-api-release-input';console.log(JSON.stringify(parseApiPackReceipt(readFileSync(process.argv[1]))));",
      "/out/evidence/pack.raw.log"
    ],
    60
  ]
]
