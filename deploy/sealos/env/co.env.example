# co 环境变量模板（**只有键名，没有值**）
#
# 真实值放在 GitHub 环境 secret `APP_ENV_FILE` 里，由 `sync-config.yml` 应用；
# 这里记录的是「这个环境需要哪些键」，用于评审与比对，避免凭据进入公开仓库。
#
# 标注 [凭据] 的键，其值必须来自 secret，绝不要提交到本仓库。

# APP_ENV_FILE — co
# 含真实值，请勿放入任何共享仓库。

# ============ 部署与站点 ============
XPOD_EDITION=
NODE_ENV=
CSS_BASE_URL=
XPOD_API_BASE_URL=
CSS_ALLOWED_HOSTS=
CSS_BASE_STORAGE_DOMAIN=

# ============ 数据层（Postgres / Redis） ============
CSS_IDENTITY_DB_URL=   # [凭据] 值来自 secret
CSS_SPARQL_ENDPOINT=
CSS_REDIS_CLIENT=

# ============ 对象存储（Cloudflare R2） ============
CSS_MINIO_ENDPOINT=
CSS_MINIO_BUCKET_NAME=
CSS_MINIO_ACCESS_KEY=   # [凭据] 值来自 secret
CSS_MINIO_SECRET_KEY=   # [凭据] 值来自 secret

# ============ 动态 DNS（设备/节点子域） ============
XPOD_DNS_PROVIDER=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=   # [凭据] 值来自 secret

# ============ 模型网关（共用） ============
DEFAULT_API_BASE=
DEFAULT_API_KEY=   # [凭据] 值来自 secret
DEFAULT_TIMEOUT_MS=
DEFAULT_GENERATION_TIMEOUT_MS=

# ============ 任务队列（inngest） ============
XPOD_INNGEST_ENABLED=
XPOD_INNGEST_EVENT_KEY=   # [凭据] 值来自 secret
XPOD_INNGEST_SIGNING_KEY=   # [凭据] 值来自 secret

# ============ 邮件 ============
CSS_EMAIL_CONFIG_HOST=
CSS_EMAIL_CONFIG_PORT=
CSS_EMAIL_CONFIG_AUTH_USER=
CSS_EMAIL_CONFIG_AUTH_PASS=

# ============ 功能开关 ============
XPOD_EDGE_NODES_ENABLED=

# ============ 运行时 ============
XPOD_GATEWAY_LOCATOR_SECRET=   # [凭据] 值来自 secret
CSS_LOGGING_LEVEL=
