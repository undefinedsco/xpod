# 白名单模式：默认忽略所有
*

# 构建需要的文件
!.dockerignore
!package.json
!LICENSE
!bun.lock
!bunfig.toml
!patches/
!patches/**
!yarn.lock
!tsconfig.json
!.componentsjs-generator-config.json
!scripts/patch-jose.js
!scripts/patch-inrupt-authn-refresh.js
!scripts/patch-inrupt-authn-transport.js
!scripts/patch-inrupt-authn-operation-cleanup.js
!scripts/check-components-runtime-metadata.cjs
!scripts/fix-dist-js-imports.mjs
!scripts/workspace-runtime-materials.cjs
!scripts/build-afs-from-producer.ts
!scripts/run-npm-pack.cjs
!scripts/prepare-package-manifest.cjs
!scripts/platform-binaries.cjs
!scripts/check-dependency-state.ts
!scripts/agentfs-native-ci/supervise.py
!scripts/lib/module-artifact-limits.json
!src/
!ui/
!desktop/
desktop/*
!desktop/package.json
!packages/
!config/
!static/
!templates/
!types/
!qlever/

# Native module receipts carry these exact recipe originals, not the docker tree.
!docker/
docker/**
!docker/qlever-runtime-sdk/
docker/qlever-runtime-sdk/**
!docker/qlever-runtime-sdk/Dockerfile.module-bookworm
!docker/qlever-runtime-sdk/Dockerfile
!docker/qlever-local-runtime/
docker/qlever-local-runtime/**
!docker/qlever-local-runtime/Dockerfile.module-bookworm
!docker/qlever-local-runtime/Dockerfile

# Never copy host build/install artifacts into the Linux build context.
**/node_modules
**/dist
**/__pycache__
**/*.pyc
**/*.pyo
**/.pytest_cache
**/.test-data

# Explicitly excluded (not needed in image)
.github/
