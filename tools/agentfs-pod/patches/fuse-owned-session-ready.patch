+#[cfg(test)]
+mod owned_session_tests {
+    use super::run_owned_session;
+    use std::sync::{Arc, atomic::{AtomicUsize, Ordering}};
+    struct DropSpy(Arc<AtomicUsize>);
+    impl Drop for DropSpy { fn drop(&mut self) { self.0.fetch_add(1, Ordering::SeqCst); } }
+    #[test]
+    fn readiness_rejection_still_runs_session_without_path_drop() {
+        let drops = Arc::new(AtomicUsize::new(0)); let runs = Arc::new(AtomicUsize::new(0)); let observed = runs.clone();
+        let result = run_owned_session(Ok(DropSpy(drops.clone())), || anyhow::bail!("foreign binding"), move |_| { observed.fetch_add(1, Ordering::SeqCst); Ok(()) });
+        assert!(result.is_err()); assert_eq!(runs.load(Ordering::SeqCst), 1); assert_eq!(drops.load(Ordering::SeqCst), 0);
+    }
+    #[test]
+    fn failed_actual_creation_never_calls_readiness_or_run() {
+        let callbacks = Arc::new(AtomicUsize::new(0)); let observed = callbacks.clone();
+        let result = run_owned_session::<DropSpy, _, _>(Err(std::io::Error::other("session creation failed")), move || { observed.fetch_add(1, Ordering::SeqCst); Ok(()) }, |_| panic!("no created session"));
+        assert!(result.is_err()); assert_eq!(callbacks.load(Ordering::SeqCst), 0);
+    }
+    #[test]
+    fn actual_process_exit_releases_retained_descriptor() {
+        const CHILD: &str = "AGENTFS_OWNED_SESSION_FD_TEST";
+        if std::env::var_os(CHILD).is_some() {
+            struct OwnedFd(libc::c_int);
+            impl Drop for OwnedFd { fn drop(&mut self) { panic!("owned descriptor must survive to process exit"); } }
+            let fd = unsafe { libc::dup(libc::STDOUT_FILENO) }; assert!(fd >= 0);
+            run_owned_session(Ok(OwnedFd(fd)), || Ok(()), |_| Ok(())).unwrap();
+            assert!(unsafe { libc::fcntl(fd, libc::F_GETFD) } >= 0);
+            std::process::exit(0);
+        }
+        let output = std::process::Command::new(std::env::current_exe().unwrap())
+            .args(["--exact", "fuse::owned_session_tests::actual_process_exit_releases_retained_descriptor", "--nocapture"])
+            .env(CHILD, "1").output().unwrap();
+        assert!(output.status.success()); // actual wait and pipe EOF after FD close
+    }
+    #[test]
+    fn actual_run_failure_and_normal_completion_never_drop_owned_path() {
+        for failed in [false, true] {
+            let drops = Arc::new(AtomicUsize::new(0));
+            let result = run_owned_session(Ok(DropSpy(drops.clone())), || Ok(()), |_| if failed { Err(std::io::Error::other("run failure")) } else { Ok(()) });
+            assert_eq!(result.is_err(), failed); assert_eq!(drops.load(Ordering::SeqCst), 0);
+        }
+    }
+}
