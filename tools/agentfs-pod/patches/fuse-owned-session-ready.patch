+/// Owned callers retire via their verified unmount protocol. Automatic Session
+/// Drop performs a path-based unmount and must never run against a replacement.
+pub fn mount_with_ready<F>(fs: Arc<dyn FileSystem>, opts: FuseMountOptions, runtime: Runtime, ready: F) -> anyhow::Result<()>
+where F: FnOnce() -> anyhow::Result<()> {
+    mount_with_session_policy(fs, opts, runtime, true, ready)
+}
+
+fn run_owned_session<S, F, R>(created: std::io::Result<S>, ready: F, run: R) -> anyhow::Result<()>
+where F: FnOnce() -> anyhow::Result<()>, R: FnOnce(&mut S) -> std::io::Result<()> {
+    // Descriptor survives until actual daemon exit; never run a path destructor.
+    let mut session = std::mem::ManuallyDrop::new(created?);
+    let readiness = ready();
+    let completion = run(&mut session);
+    // A readiness rejection still serves the actual session; the caller keeps
+    // its owner/control/lease when binding is unknown rather than faking close.
+    readiness?;
+    completion?;
+    Ok(())
+}
+
+fn mount_with_session_policy<F>(fs: Arc<dyn FileSystem>, opts: FuseMountOptions, runtime: Runtime, owned: bool, ready: F) -> anyhow::Result<()>
+where F: FnOnce() -> anyhow::Result<()> {
     // Raise fd limit to hard limit to prevent "too many open files" errors
     // when passthrough filesystems cache O_PATH file descriptors
     maximize_fd_limit();
