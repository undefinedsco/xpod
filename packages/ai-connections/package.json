{
  "name": "@undefineds.co/ai-connections",
  "version": "0.1.0-rc.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./client": {
      "types": "./dist/contract/ai-connections-client.d.ts",
      "import": "./dist/contract/ai-connections-client.js"
    },
    "./provider-catalog": {
      "types": "./dist/contract/provider-catalog.d.ts",
      "import": "./dist/contract/provider-catalog.js",
      "require": "./dist/contract/provider-catalog.cjs"
    },
    "./client-config": {
      "types": "./dist/contract/client-config/index.d.ts",
      "import": "./dist/contract/client-config/index.js",
      "require": "./dist/contract/client-config/index.cjs"
    },
    "./endpoint-urls": {
      "types": "./dist/contract/endpoint-urls.d.ts",
      "import": "./dist/contract/endpoint-urls.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && bun ../../scripts/fix-dist-js-imports.mjs dist && bun build src/contract/client-config/index.ts --target=node --format=cjs --outfile=dist/contract/client-config/index.cjs && bun build src/contract/provider-catalog.ts --target=node --format=cjs --outfile=dist/contract/provider-catalog.cjs",
    "test": "vitest run --config ../../vitest.packages.config.mts"
  },
  "dependencies": {
    "@undefineds.co/extension-sdk": "workspace:*",
    "@undefineds.co/models": "0.2.59",
    "@undefineds.co/pod-collections": "workspace:*",
    "@undefineds.co/shared-ui": "workspace:*",
    "lucide-react": "^0.525.0"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "jsdom": "^29.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "typesVersions": {
    "*": {
      "manifest": [
        "dist/manifest.d.ts"
      ],
      "provider-catalog": [
        "dist/contract/provider-catalog.d.ts"
      ],
      "client": [
        "dist/contract/ai-connections-client.d.ts"
      ],
      "client-config": [
        "dist/contract/client-config/index.d.ts"
      ],
      "endpoint-urls": [
        "dist/contract/endpoint-urls.d.ts"
      ]
    }
  }
}
