      "ai": [
        "dist/ai.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && bun ../../scripts/fix-dist-js-imports.mjs dist && bun ../../scripts/workspace-runtime-materials.cjs . '[]'"
  },
  "devDependencies": {
    "typescript": "5.5"
  }
}
