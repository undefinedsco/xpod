{
  "name": "@undefineds.co/solid-sdk",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./pod-runtime": {
      "types": "./dist/pod-runtime.d.ts",
      "import": "./dist/pod-runtime.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./webid-auth": {
      "types": "./dist/webid-auth.d.ts",
      "import": "./dist/webid-auth.js"
    },
    "./storage-selection": {
      "types": "./dist/storage-selection.d.ts",
      "import": "./dist/storage-selection.js"
    },
    "./login-store": {
      "types": "./dist/login-store.d.ts",
      "import": "./dist/login-store.js"
    },
    "./local-route-fetch": {
      "types": "./dist/local-route-fetch.d.ts",
      "import": "./dist/local-route-fetch.js",
      "require": "./dist/local-route-fetch.cjs"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && bun ../../scripts/fix-dist-js-imports.mjs dist && bun build src/index.ts --target=node --format=cjs --packages=external --outfile=dist/index.cjs && bun build src/local-route-fetch.ts --target=node --format=cjs --packages=external --outfile=dist/local-route-fetch.cjs",
    "test": "vitest run test --config ../../vitest.packages.config.mts"
  },
  "dependencies": {
    "@inrupt/solid-client-authn-browser": "^3.1.1",
    "zustand": "^5.0.13"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "react": "^19.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
