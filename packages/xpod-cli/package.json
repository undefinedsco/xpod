{
  "name": "@undefineds.co/xpod-cli",
  "version": "0.1.0-preview.2",
  "description": "Xpod command-line client with on-demand capability modules",
  "license": "MIT",
  "type": "module",
  "bin": {
    "xpod": "./dist/bin/xpod"
  },
  "scripts": {
    "build": "bun scripts/build-package.ts",
    "build:cli-only": "bun scripts/build.ts --cli-only",
    "verify": "bun run typecheck && bun run test && bun run build",
    "test": "bun test ./tests/module-catalog.test.ts ./tests/module-store.test.ts ./tests/start.test.ts ./tests/runtime-owner.test.ts ./tests/launcher.test.ts ./tests/javascript-notices.test.ts ./tests/producer-materials.test.ts",
    "build:preview": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.core.json",
    "test:preview": "bun test ./tests",
    "verify:preview": "bun scripts/verify-install.ts",
    "build:tools": "bun scripts/build-tools-package.ts"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "http-proxy": "^1.18.1",
    "global-logger-factory": "1.0.0",
    "ws": "^8.18.0",
    "debug": "^4.4.3",
    "@types/http-proxy": "^1.17.17",
    "@types/ws": "^8.18.1",
    "@inrupt/solid-client-authn-node": "^3.1.0",
    "yargs": "^17.7.2",
    "tar": "^7.5.3",
    "typescript": "5.5",
    "@types/node": "^22",
    "@types/yargs": "^17.0.33"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./client": {
      "types": "./dist/client-types/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.cjs"
    },
    "./build-tools": {
      "types": "./dist/build-tools-types/build-tools.d.ts",
      "import": "./dist/build-tools.mjs",
      "require": "./dist/build-tools.cjs"
    },
    "./producer-materials": "./dist/producer-materials/index.json",
    "./output": {
      "types": "./dist/client-types/lib/output.d.ts",
      "import": "./dist/output.mjs"
    }
  },
  "peerDependencies": {
    "@inrupt/solid-client-authn-node": "^3.1.1"
  },
  "peerDependenciesMeta": {
    "@inrupt/solid-client-authn-node": {
      "optional": true
    }
  },
  "typesVersions": {
    "*": {
      "client": [
        "dist/client-types/client.d.ts"
      ],
      "build-tools": [
        "dist/build-tools-types/build-tools.d.ts"
      ],
      "output": [
        "dist/client-types/lib/output.d.ts"
      ]
    }
  },
  "dependencies": {
    "@undefineds.co/xpod-client": "workspace:*"
  }
}
