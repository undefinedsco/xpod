{
  "name": "@undefineds.co/ai-connection",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/ai-connection-client.d.ts",
      "import": "./dist/ai-connection-client.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./client-config": {
      "types": "./dist/client-config/index.d.ts",
      "import": "./dist/client-config/index.js",
      "require": "./dist/client-config/index.cjs"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node ../../scripts/fix-dist-js-imports.mjs dist && bun build src/client-config/index.ts --target=node --format=cjs --outfile=dist/client-config/index.cjs",
    "test": "vitest run --config ../../vitest.packages.config.mts"
  },
  "dependencies": {
    "@undefineds.co/extension-sdk": "workspace:*",
    "@undefineds.co/shared-ui": "workspace:*",
    "lucide-react": "^0.475.0"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "jsdom": "^29.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
