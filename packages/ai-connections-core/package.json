{
  "name": "@undefineds.co/ai-connections-core",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/ai-connections-client.d.ts",
      "import": "./dist/ai-connections-client.js"
    },
    "./provider-catalog": {
      "types": "./dist/provider-catalog.d.ts",
      "import": "./dist/provider-catalog.js",
      "require": "./dist/provider-catalog.cjs"
    },
    "./client-config": {
      "types": "./dist/client-config/index.d.ts",
      "import": "./dist/client-config/index.js",
      "require": "./dist/client-config/index.cjs"
    },
    "./endpoint-urls": {
      "types": "./dist/endpoint-urls.d.ts",
      "import": "./dist/endpoint-urls.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && bun ../../scripts/fix-dist-js-imports.mjs dist && bun build src/client-config/index.ts --target=node --format=cjs --outfile=dist/client-config/index.cjs && bun build src/provider-catalog.ts --target=node --format=cjs --outfile=dist/provider-catalog.cjs",
    "test": "vitest run --config ../../vitest.packages.config.mts"
  },
  "dependencies": {
    "@undefineds.co/extension-sdk": "workspace:*",
    "@undefineds.co/models": "0.2.59"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "typesVersions": {
    "*": {
      "provider-catalog": [
        "dist/provider-catalog.d.ts"
      ],
      "client": [
        "dist/ai-connections-client.d.ts"
      ],      "client-config": [
        "dist/client-config/index.d.ts"
      ],
      "endpoint-urls": [
        "dist/endpoint-urls.d.ts"
      ]
    }
  }
}
