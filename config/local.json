{
  "@context": [
    "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server/^8.0.0/components/context.jsonld",
    "https://linkedsoftwaredependencies.org/bundles/npm/@undefineds.co/xpod/^0.0.0/components/context.jsonld",
    "https://linkedsoftwaredependencies.org/bundles/npm/asynchronous-handlers/^1.0.0/components/context.jsonld",
    {
      "SqliteVectorStore_operationService": "SqliteVectorStore:_options_operationService",
      "VectorHttpHandler_operationService": "VectorHttpHandler:_options_operationService",
      "LocalPhysicalOperationService_rootFilePath": "LocalPhysicalOperationService:_rootFilePath",
      "RootedSolidFsSyncJournal_operationService": "RootedSolidFsSyncJournal:_operationService",
      "SolidRdfEngine_operationService": "SolidRdfEngine:_options_operationService",
      "LocalRdfAuthorityRecoveryInitializer_operationService": "LocalRdfAuthorityRecoveryInitializer:_operationService",
      "LocalRdfAuthorityRecoveryInitializer_rdfEngine": "LocalRdfAuthorityRecoveryInitializer:_rdfEngine",
      "LocalPhysicalParsingHttpHandler_credentialsExtractor": "LocalPhysicalParsingHttpHandler:_credentialsExtractor",
      "LocalPhysicalParsingHttpHandler_operationService": "LocalPhysicalParsingHttpHandler:_operationService",
      "LockingResourceStore_operationService": "LockingResourceStore:_options_operationService",
      "MixDataAccessor_operationService": "MixDataAccessor:_operationService",
      "SolidRdfDataAccessor_operationService": "SolidRdfDataAccessor:_operationService",
      "SubgraphSparqlHttpHandler_operationService": "SubgraphSparqlHttpHandler:_operationService",
      "LocalPhysicalParsingHttpHandler_requestParser": "LocalPhysicalParsingHttpHandler:_args_requestParser",
      "LocalPhysicalParsingHttpHandler_errorHandler": "LocalPhysicalParsingHttpHandler:_args_errorHandler",
      "LocalPhysicalParsingHttpHandler_responseWriter": "LocalPhysicalParsingHttpHandler:_args_responseWriter",
      "LocalPhysicalParsingHttpHandler_operationHandler": "LocalPhysicalParsingHttpHandler:_args_operationHandler"
    }
  ],
  "import": [
    "./main.json",
    "./xpod.base.json",
    "./terminal.json",
    "./extensions.local.initializer.json"
  ],
  "@graph": [
    {
      "comment": "Quota service backed by identity DB, no env defaults = unlimited",
      "@id": "urn:undefineds:xpod:QuotaService",
      "@type": "DrizzleQuotaService",
      "DrizzleQuotaService:_options_identityDbUrl": {
        "@id": "urn:solid-server:default:variable:identityDbUrl",
        "@type": "Variable"
      }
    },
    {
      "comment": "定义 oidcIssuer 变量（外部 OIDC issuer 基础 URL），设置后本地仍提供 account/consent/SP 页面",
      "@id": "urn:solid-server:default:variable:oidcIssuer",
      "@type": "Variable"
    },
    {
      "comment": "Auto-detect OIDC pass-through - 有 oidcIssuer 时也保持本地 CSS OIDC discovery/token/JWKS 同源",
      "@id": "urn:undefineds:xpod:AutoDetectOidcHandler",
      "@type": "AutoDetectOidcHandler",
      "AutoDetectOidcHandler:_options_oidcIssuer": {
        "@id": "urn:solid-server:default:variable:oidcIssuer"
      },
      "AutoDetectOidcHandler:_options_cacheMs": 300000
    },
    {
      "comment": "CSS 原生 IdentityProvider parsing handler，始终用于本地 account/consent/WebID 选择页面",
      "@id": "urn:undefineds:xpod:SourceIdentityProviderHandler",
      "@type": "RouterHandler",
      "baseUrl": {
        "@id": "urn:solid-server:default:variable:baseUrl"
      },
      "targetExtractor": {
        "@id": "urn:solid-server:default:TargetExtractor"
      },
      "allowedPathNames": [
        "^/.account(/.*)?$"
      ],
      "handler": {
        "@id": "urn:solid-server:default:IdentityProviderParsingHandler"
      }
    },
    {
      "comment": "Auto-detect Identity Provider Handler - 有 oidcIssuer 时仍委托本地 account/consent，避免 Local 登录漏到 Cloud Pod",
      "@id": "urn:undefineds:xpod:AutoDetectIdentityProviderHandler",
      "@type": "AutoDetectIdentityProviderHandler",
      "AutoDetectIdentityProviderHandler:_options_oidcIssuer": {
        "@id": "urn:solid-server:default:variable:oidcIssuer"
      },
      "AutoDetectIdentityProviderHandler:_options_source": {
        "@id": "urn:undefineds:xpod:SourceIdentityProviderHandler"
      }
    },
    {
      "comment": "Override: 使用 AutoDetectIdentityProviderHandler 替换默认 Handler",
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:IdentityProviderHandler"
      },
      "overrideParameters": {
        "@id": "urn:undefineds:xpod:AutoDetectIdentityProviderHandler"
      }
    },
    {
      "comment": "Recover the local RDF authority journal after primary initialization and before workers start.",
      "@id": "urn:solid-server:default:PrimarySequenceInitializer",
      "@type": "SequenceHandler",
      "handlers": [
        {
          "@id": "urn:solid-server:default:CleanupInitializer"
        },
        {
          "@id": "urn:solid-server:default:MigrationInitializer"
        },
        {
          "@id": "urn:solid-server:default:BaseUrlVerifier"
        },
        {
          "@id": "urn:solid-server:default:PrimaryParallelInitializer"
        },
        {
          "@id": "urn:solid-server:default:ModuleVersionVerifier"
        },
        {
          "@id": "urn:undefineds:xpod:LocalRdfAuthorityRecoveryInitializer"
        },
        {
          "@id": "urn:solid-server:default:WorkerManager"
        },
        {
          "@id": "urn:solid-server:default:SeededAccountInitializer"
        },
        {
          "@id": "urn:undefineds:xpod:EdgeNodeAgentInitializer"
        }
      ]
    },
    {
      "@id": "urn:undefineds:xpod:LocalPhysicalOperationService",
      "@type": "LocalPhysicalOperationService",
      "LocalPhysicalOperationService_rootFilePath": {
        "@id": "urn:solid-server:default:variable:rootFilePath",
        "@type": "Variable"
      }
    },
    {
      "comment": "Persistent outbox for Local authority-file writes and startup recovery.",
      "@id": "urn:undefineds:xpod:LocalRdfAuthorityJournal",
      "@type": "RootedSolidFsSyncJournal",
      "RootedSolidFsSyncJournal_operationService": {
        "@id": "urn:undefineds:xpod:LocalPhysicalOperationService"
      },
      "rootFilePath": {
        "@id": "urn:solid-server:default:variable:rootFilePath",
        "@type": "Variable"
      }
    },
    {
      "comment": "Rebuild the derived Local RDF index before CSS workers start.",
      "@id": "urn:undefineds:xpod:LocalRdfAuthorityRecoveryInitializer",
      "@type": "LocalRdfAuthorityRecoveryInitializer",
      "LocalRdfAuthorityRecoveryInitializer_operationService": {
        "@id": "urn:undefineds:xpod:LocalPhysicalOperationService"
      },
      "LocalRdfAuthorityRecoveryInitializer_rdfEngine": {
        "@id": "urn:undefineds:xpod:SolidRdfEngine"
      },
      "journal": {
        "@id": "urn:undefineds:xpod:LocalRdfAuthorityJournal"
      },
      "index": {
        "@id": "urn:undefineds:xpod:MixDataAccessor"
      },
      "resourceMapper": {
        "@id": "urn:solid-server:default:FileIdentifierMapper"
      },
      "baseUrl": {
        "@id": "urn:solid-server:default:variable:baseUrl",
        "@type": "Variable"
      },
      "rootFilePath": {
        "@id": "urn:solid-server:default:variable:rootFilePath",
        "@type": "Variable"
      }
    },
    {
      "@id": "urn:solid-server:default:CleanupFinalizer",
      "@type": "SequenceHandler",
      "handlers": [
        {
          "@type": "FinalizableHandler",
          "finalizable": {
            "@id": "urn:undefineds:xpod:LocalRdfAuthorityRecoveryInitializer"
          }
        }
      ]
    },
    {
      "@id": "urn:solid-server:default:variable:rootFilePath",
      "@value": "./data"
    },
    {
      "comment": "Vector API storage sharing the canonical Local RDF SQLite file.",
      "@id": "urn:undefineds:xpod:VectorStore",
      "@type": "SqliteVectorStore",
      "SqliteVectorStore_operationService": { "@id": "urn:undefineds:xpod:LocalPhysicalOperationService" },
      "options_connectionString": {
        "@id": "urn:solid-server:default:variable:rdfIndexPath",
        "@type": "Variable"
      }
    },
    {
      "comment": "Vector HTTP Handler",
      "@id": "urn:undefineds:xpod:VectorHttpHandler",
      "@type": "VectorHttpHandler",
      "VectorHttpHandler_operationService": { "@id": "urn:undefineds:xpod:LocalPhysicalOperationService" },
      "vectorStore": {
        "@id": "urn:undefineds:xpod:VectorStore"
      },
      "credentialsExtractor": {
        "@id": "urn:solid-server:default:CredentialsExtractor"
      },
      "permissionReader": {
        "@id": "urn:solid-server:default:PermissionReader"
      },
      "authorizer": {
        "@id": "urn:solid-server:default:Authorizer"
      }
    },
    {
      "comment": "Local FTS index sharing the canonical RDF SQLite file.",
      "@id": "urn:undefineds:xpod:RdfTextIndex",
      "@type": "RdfTextIndex",
      "options_path": {
        "@id": "urn:solid-server:default:variable:rdfIndexPath",
        "@type": "Variable"
      }
    },
    {
      "comment": "Local vector index sharing the canonical RDF SQLite file.",
      "@id": "urn:undefineds:xpod:RdfVectorIndex",
      "@type": "RdfVectorIndex",
      "options_path": {
        "@id": "urn:solid-server:default:variable:rdfIndexPath",
        "@type": "Variable"
      },
      "options_defaultMetric": "cosine"
    },
    {
      "comment": "Persistent native-only QLever process backed by the canonical RDF SQLite file.",
      "@id": "urn:undefineds:xpod:LocalQleverNativeSparqlClient",
      "@type": "LocalQleverNativeSparqlClient",
      "options_args": [
        "--sqlite-path",
        {
          "@id": "urn:solid-server:default:variable:rdfIndexPath",
          "@type": "Variable"
        }
      ]
    },
    {
      "comment": "RDF facts, FTS, VEC, and native QLever share one Local SQLite file.",
      "@id": "urn:undefineds:xpod:SolidRdfEngine",
      "@type": "SolidRdfEngine",
      "SolidRdfEngine_operationService": {
        "@id": "urn:undefineds:xpod:LocalPhysicalOperationService"
      },
      "index_path": {
        "@id": "urn:solid-server:default:variable:rdfIndexPath",
        "@type": "Variable"
      },
      "textIndex": {
        "@id": "urn:undefineds:xpod:RdfTextIndex"
      },
      "vectorIndex": {
        "@id": "urn:undefineds:xpod:RdfVectorIndex"
      },
      "nativeSparqlClient": {
        "@id": "urn:undefineds:xpod:LocalQleverNativeSparqlClient"
      },
      "autoOpen": false
    },
    {
      "comment": "Default SPARQL engine: every server-owned Pod query requires native QLever.",
      "@id": "urn:undefineds:xpod:DefaultSparqlEngine",
      "@type": "QleverSparqlEngine",
      "rdfEngine": {
        "@id": "urn:undefineds:xpod:SolidRdfEngine"
      }
    },
    {
      "comment": "Use SolidRdfEngine for structured RDF data and local filesystem for other content.",
      "@id": "urn:undefineds:xpod:MixDataAccessor",
      "@type": "MixDataAccessor",
      "structuredDataAccessor": {
        "@id": "urn:undefineds:xpod:SolidRdfDataAccessor"
      },
      "unstructuredDataAccessor": {
        "@id": "urn:solid-server:default:FileDataAccessor"
      },
      "rdfFileDataAccessor": {
        "@id": "urn:undefineds:xpod:AtomicRdfFileDataAccessor"
      },
      "rdfFileMapper": {
        "@id": "urn:solid-server:default:FileIdentifierMapper"
      },
      "textSearchIndexingEnabled": true,
      "localRdfAuthorityJournal": {
        "@id": "urn:undefineds:xpod:LocalRdfAuthorityJournal"
      },
      "rdfSearchIntentSink": {
        "@id": "urn:undefineds:xpod:RdfSearchIntentSink"
      },
      "MixDataAccessor_operationService": {
        "@id": "urn:undefineds:xpod:LocalPhysicalOperationService"
      }
    },
    {
      "comment": "Default structured RDF data accessor backed directly by SolidRdfEngine.",
      "@id": "urn:undefineds:xpod:SolidRdfDataAccessor",
      "@type": "SolidRdfDataAccessor",
      "rdfEngine": {
        "@id": "urn:undefineds:xpod:SolidRdfEngine"
      },
      "identifierStrategy": {
        "@id": "urn:solid-server:default:IdentifierStrategy"
      },
      "SolidRdfDataAccessor_operationService": {
        "@id": "urn:undefineds:xpod:LocalPhysicalOperationService"
      }
    },
    {
      "comment": "等位替换: 用 SparqlUpdateResourceStore 替换默认的 DataAccessorBasedStore",
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:ResourceStore_Backend"
      },
      "overrideParameters": {
        "@type": "SparqlUpdateResourceStore",
        "identifierStrategy": {
          "@id": "urn:solid-server:default:IdentifierStrategy"
        },
        "auxiliaryStrategy": {
          "@id": "urn:solid-server:default:AuxiliaryStrategy"
        },
        "metadataStrategy": {
          "@id": "urn:solid-server:default:MetadataStrategy"
        },
        "accessor": {
          "@id": "urn:undefineds:xpod:MixDataAccessor"
        }
      }
    },
    {
      "comment": "等位替换: 用 RepresentationPartialConvertingStore 替换 Converting 层，只转换 RDF 类型",
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:ResourceStore_Converting"
      },
      "overrideParameters": {
        "@type": "RepresentationPartialConvertingStore",
        "source": {
          "@id": "urn:solid-server:default:ResourceStore_Backend"
        },
        "metadataStrategy": {
          "@id": "urn:solid-server:default:MetadataStrategy"
        },
        "options_inConverter": {
          "@id": "urn:solid-server:default:RepresentationConverter"
        },
        "options_outConverter": {
          "@id": "urn:solid-server:default:RepresentationConverter"
        },
        "options_inPreferences_type": {
          "RepresentationPartialConvertingStore:_options_inPreferences_type_key": "internal/quads",
          "RepresentationPartialConvertingStore:_options_inPreferences_type_value": 1
        }
      }
    },
    {
      "comment": "等位替换: 用 AuthorityETagHandler 包裹默认 BasicETagHandler。仅为 Local 文件权威 RDF 的完整 Turtle 文档提供 authority 派生的文档版本，未受影响的资源/存储族继续委托原 CSS validator，不在全局关闭既有校验能力。",
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:ETagHandler"
      },
      "overrideParameters": {
        "@type": "AuthorityETagHandler",
        "delegate": {
          "@type": "BasicETagHandler"
        }
      }
    },
    {
      "comment": "等位替换: 内存锁外层再包一层层级锁；祖先共享、目标读写，使 scoped SPARQL 写入与同容器内的每日文档 LDP 写入互斥。替换 WrappedExpiringReadWriteLocker 是为了去掉 Promise.race 超时释放仍在运行回调的行为。",
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:ResourceLocker"
      },
      "overrideParameters": {
        "@type": "HierarchicalReadWriteLocker",
        "locker": {
          "@type": "GreedyReadWriteLocker",
          "locker": {
            "@type": "MemoryResourceLocker"
          },
          "storage": {
            "@type": "MemoryMapStorage"
          }
        },
        "identifierStrategy": {
          "@id": "urn:solid-server:default:IdentifierStrategy"
        }
      }
    },
    {
      "comment": "Use SQLite-based KeyValueStorage for internal data (avoids .internal directory)",
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:KeyValueStorage"
      },
      "overrideParameters": {
        "@type": "SqliteKeyValueStorage",
        "path": {
          "@id": "urn:solid-server:default:variable:identityDbUrl",
          "@type": "Variable"
        }
      }
    },
    {
      "@id": "urn:solid-server:default:variable:registration",
      "@value": true
    },
    {
      "comment": "Compose local HTTP pipeline without edge handlers",
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:BaseHttpHandler"
      },
      "overrideParameters": {
        "@type": "StatusWaterfallHandler",
        "handlers": [
          {
            "@id": "urn:undefineds:xpod:SubgraphSparqlHttpHandler"
          },
          {
            "@id": "urn:undefineds:xpod:VectorHttpHandler"
          },
          {
            "@id": "urn:undefineds:xpod:TerminalHttpHandler"
          },
          {
            "@id": "urn:undefineds:xpod:AppStaticAssetHandler"
          },
          {
            "@id": "urn:solid-server:default:StaticAssetHandler"
          },
          {
            "comment": "Local 模式下 OIDC discovery/token/JWKS 全部由 CSS 默认 OIDC handler 处理，避免本地 token 与外部 JWKS 错配",
            "@id": "urn:undefineds:xpod:AutoDetectOidcHandler"
          },
          {
            "@id": "urn:solid-server:default:OidcHandler"
          },
          {
            "@id": "urn:solid-server:default:NotificationHttpHandler"
          },
          {
            "@id": "urn:solid-server:default:StorageDescriptionHandler"
          },
          {
            "@id": "urn:solid-server:default:AuthResourceHttpHandler"
          },
          {
            "@id": "urn:solid-server:default:IdentityProviderHandler"
          },
          {
            "@id": "urn:solid-server:default:LdpHandler"
          }
        ]
      }
    },
    {
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:LdpHandler"
      },
      "overrideParameters": {
        "@type": "LocalPhysicalParsingHttpHandler",
        "LocalPhysicalParsingHttpHandler_credentialsExtractor": {
          "@id": "urn:solid-server:default:CredentialsExtractor"
        },
        "LocalPhysicalParsingHttpHandler_operationService": {
          "@id": "urn:undefineds:xpod:LocalPhysicalOperationService"
        },
        "LocalPhysicalParsingHttpHandler_requestParser": {
          "@id": "urn:solid-server:default:RequestParser"
        },
        "LocalPhysicalParsingHttpHandler_errorHandler": {
          "@id": "urn:solid-server:default:ErrorHandler"
        },
        "LocalPhysicalParsingHttpHandler_responseWriter": {
          "@id": "urn:solid-server:default:ResponseWriter"
        },
        "LocalPhysicalParsingHttpHandler_operationHandler": {
          "@type": "AuthorizingHttpHandler",
          "args_credentialsExtractor": {
            "@id": "urn:solid-server:default:CredentialsExtractor"
          },
          "args_modesExtractor": {
            "@id": "urn:solid-server:default:ModesExtractor"
          },
          "args_permissionReader": {
            "@id": "urn:solid-server:default:PermissionReader"
          },
          "args_authorizer": {
            "@id": "urn:solid-server:default:Authorizer"
          },
          "args_operationHandler": {
            "@type": "WacAllowHttpHandler",
            "args_credentialsExtractor": {
              "@id": "urn:solid-server:default:CredentialsExtractor"
            },
            "args_modesExtractor": {
              "@id": "urn:solid-server:default:ModesExtractor"
            },
            "args_permissionReader": {
              "@id": "urn:solid-server:default:PermissionReader"
            },
            "args_operationHandler": {
              "@id": "urn:solid-server:default:OperationHandler"
            }
          }
        }
      }
    },
    {
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:undefineds:xpod:LockingResourceStoreOverride"
      },
      "overrideParameters": {
        "LockingResourceStore_operationService": {
          "@id": "urn:undefineds:xpod:LocalPhysicalOperationService"
        }
      }
    },
    {
      "@id": "urn:undefineds:xpod:SubgraphSparqlHttpHandler",
      "SubgraphSparqlHttpHandler_operationService": {
        "@id": "urn:undefineds:xpod:LocalPhysicalOperationService"
      }
    }
  ]
}
