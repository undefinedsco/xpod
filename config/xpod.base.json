  "@graph": [
    {
      "comment": "Preserve CSS response headers and status while suppressing generated HEAD error bodies before the Bun HTTP writer.",
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:ResponseWriter" },
      "overrideParameters": {
        "@type": "HeadSafeResponseWriter",
        "headResponseMetadataWriter": { "@id": "urn:solid-server:default:MetadataWriter" }
      }
    },
    {
      "comment": "Use persisted storage revisions for GET/HEAD, conditions and notifications; legacy revisions are initialized under resource write locks before reads.",
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:ETagHandler" },
      "overrideParameters": { "@type": "StorageETagHandler" }
    },
    {
      "comment": "Keep the configured local/Redis lock authority and acquire ancestors root-first for every mutation.",
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:ResourceStore_Locking" },
      "overrideParameters": {
        "@type": "HierarchyLockingResourceStore",
        "hierarchySource": { "@id": "urn:solid-server:default:ResourceStore_Patching" },
        "hierarchyLocks": { "@id": "urn:solid-server:default:ResourceLocker" },
        "hierarchyAuxiliaryStrategy": { "@id": "urn:solid-server:default:AuxiliaryStrategy" },
        "hierarchyIdentifierStrategy": { "@id": "urn:solid-server:default:IdentifierStrategy" }
      }
    },
    {
      "comment": "Preserve the CSS operation waterfall, replacing PUT with a response bound to its own persisted mutation receipt.",
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:OperationHandler" },
      "overrideParameters": {
        "@type": "StatusWaterfallHandler",
        "handlers": [
          { "@type": "GetOperationHandler", "store": { "@id": "urn:solid-server:default:ResourceStore" }, "eTagHandler": { "@id": "urn:solid-server:default:ETagHandler" } },
          { "@type": "PostOperationHandler", "store": { "@id": "urn:solid-server:default:ResourceStore" } },
          { "@type": "StoragePutOperationHandler", "versionPutStore": { "@id": "urn:solid-server:default:ResourceStore" }, "versionPutMetadataStrategy": { "@id": "urn:solid-server:default:MetadataStrategy" }, "versionPutETagHandler": { "@id": "urn:solid-server:default:ETagHandler" } },
          { "@type": "DeleteOperationHandler", "store": { "@id": "urn:solid-server:default:ResourceStore" } },
          { "@type": "HeadOperationHandler", "store": { "@id": "urn:solid-server:default:ResourceStore" }, "eTagHandler": { "@id": "urn:solid-server:default:ETagHandler" } },
          { "@type": "PatchOperationHandler", "store": { "@id": "urn:solid-server:default:ResourceStore" } },
          { "@type": "StaticThrowHandler", "onlyHandle": true, "factory": { "@type": "ClassErrorFactory", "error": { "@type": "MethodNotAllowedHttpError" } } }
        ]
      }
    },
    {
      "@id": "urn:undefineds:xpod:RememberedClientGrantStore",
      "@type": "RememberedClientGrantStore",
      "rememberedGrantStorage": {
        "@type": "WrappedExpiringStorage",
        "source": {
          "@type": "ContainerPathStorage",
          "relativePath": "/idp/remembered-clients/",
          "source": { "@id": "urn:solid-server:default:KeyValueStorage" }
        }
      }
    },
    {
      "comment": "Retain default account/WebID checks and restore explicitly remembered Desktop grants before consent.",
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:PromptFactory" },
      "overrideParameters": {
        "@type": "RememberedClientPromptFactory",
        "rememberedPromptSource": {
          "@type": "AccountPromptFactory",
          "webIdStore": { "@id": "urn:solid-server:default:WebIdStore" },
          "cookieStore": { "@id": "urn:solid-server:default:CookieStore" },
          "cookieName": { "@id": "urn:solid-server:default:value:accountCookieName" }
        },
        "rememberedPromptStore": { "@id": "urn:undefineds:xpod:RememberedClientGrantStore" }
      }
    },
    {
      "comment": "Keep CSS consent processing and persist the user's explicit remember-app choice.",
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:ConsentHandler" },
      "overrideParameters": {
        "@type": "StatusWaterfallHandler",
        "handlers": [
          {
            "@type": "MethodFilterHandler",
            "methods": [ "GET" ],
            "source": {
              "@type": "ClientInfoHandler",
              "providerFactory": { "@id": "urn:solid-server:default:IdentityProviderFactory" }
            }
          },
          {
            "@type": "MethodFilterHandler",
            "methods": [ "POST" ],
            "source": {
              "@type": "RememberedConsentHandler",
              "rememberedConsentProvider": { "@id": "urn:solid-server:default:IdentityProviderFactory" },
              "rememberedConsentSource": {
                "@type": "ConsentHandler",
                "providerFactory": { "@id": "urn:solid-server:default:IdentityProviderFactory" }
              },
              "rememberedConsentStore": { "@id": "urn:undefineds:xpod:RememberedClientGrantStore" }
            }
          }
        ]
      }
    },
    {
      "comment": "Close the profile-owned RDF authority after writes stop.",
      "@id": "urn:solid-server:default:CleanupFinalizer",
      "@type": "SequenceHandler",
      "handlers": [
        {
          "@type": "FinalizableHandler",
          "finalizable": { "@id": "urn:undefineds:xpod:SolidRdfDataAccessor" }
        }
      ]
    },
    {
      "comment": "Core mode: server or local",
      "@id": "urn:solid-server:default:variable:edition",
      "@type": "Variable"
    },
    {
      "comment": "Whether edge node registry is enabled.",
      "@id": "urn:solid-server:default:variable:edgeNodesEnabled",
      "@type": "Variable"
    },
    {
      "comment": "Durable search intent sink for committed RDF/text source changes.",
      "@id": "urn:undefineds:xpod:RdfSearchIntentSink",
      "@type": "RdfSearchReconciliationIntentSink",
      "identityDbUrl": {
        "@id": "urn:solid-server:default:variable:identityDbUrl",
        "@type": "Variable"
      }
    },
    {
      "comment": "An accessor for a Minio",
      "@type": "MinioDataAccessor",
      "@id": "urn:undefineds:xpod:MinioDataAccessor"
    },
    {
