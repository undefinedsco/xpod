{
  "@context": [
    "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server/^8.0.0/components/context.jsonld",
    "https://linkedsoftwaredependencies.org/bundles/npm/@undefineds.co/xpod/^0.0.0/components/context.jsonld",
    "https://linkedsoftwaredependencies.org/bundles/npm/asynchronous-handlers/^1.0.0/components/context.jsonld"
  ],
  "import": [
    "./cli.json",
    "./resolver.json"
  ],
  "@graph": [
    {
      "comment": "Core mode: server or local",
      "@id": "urn:solid-server:default:variable:edition",
      "@type": "Variable"
    },
    {
      "comment": "Whether edge node registry is enabled.",
      "@id": "urn:solid-server:default:variable:edgeNodesEnabled",
      "@type": "Variable"
    },
    {
      "comment": "An accessor for a Quadstore",
      "@type": "QuadstoreSparqlDataAccessor",
      "@id": "urn:undefineds:xpod:QuadstoreSparqlDataAccessor",
      "endpoint": {
        "@id": "urn:solid-server:default:variable:sparqlEndpoint",
        "@type": "Variable"
      },
      "identifierStrategy": {
        "@id": "urn:solid-server:default:IdentifierStrategy"
      }
    },
    {
      "comment": "An accessor for a Minio",
      "@type": "MinioDataAccessor",
      "@id": "urn:undefineds:xpod:MinioDataAccessor"
    },
    {
      "comment": "Static Asset Handler for the React UI.",
      "@type": "AppStaticAssetHandler",
      "@id": "urn:undefineds:xpod:AppStaticAssetHandler"
    },
    {
      "comment": "Override root static asset to serve xpod SPA shell page.",
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:RootStaticAsset"
      },
      "overrideParameters": {
        "@type": "StaticAssetEntry",
        "relativeUrl": "/",
        "filePath": "./static/app/index.html"
      }
    },
    {
      "comment": "Reserve admin routes for control plane and prevent conflicting pod IDs.",
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:IdentifierGenerator"
      },
      "overrideParameters": {
        "@type": "ReservedSuffixIdentifierGenerator",
        "baseUrl": {
          "@id": "urn:solid-server:default:variable:baseUrl",
          "@type": "Variable"
        },
        "reserved": [
          "admin"
        ]
      }
    },
    {
      "comment": "Replace HtmlViewHandler with ReactAppViewHandler - serves single React app for all identity routes.",
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:HtmlViewHandler"
      },
      "overrideParameters": {
        "@type": "ReactAppViewHandler",
        "index": { "@id": "urn:solid-server:default:IndexRoute" },
        "htmlFile": "./static/app/auth.html"
      }
    },
    {
      "comment": "Validate CSS account cookies against account storage to avoid stale browser sessions after data resets.",
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:IdentityProviderHttpHandler"
      },
      "overrideParameters": {
        "@type": "ValidatingIdentityProviderHttpHandler",
        "providerFactory": {
          "@id": "urn:solid-server:default:IdentityProviderFactory"
        },
        "cookieStore": {
          "@id": "urn:solid-server:default:CookieStore"
        },
        "handler": {
          "@id": "urn:solid-server:default:InteractionHandler"
        },
        "accountStorage": {
          "@id": "urn:solid-server:default:AccountStorage"
        }
      }
    },
    {
      "comment": "Keep full Solid OIDC and DPoP verification while admitting the configured HTTP loopback IP origin used by the desktop runtime.",
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:DPoPWebIdExtractor"
      },
      "overrideParameters": {
        "@type": "ConfiguredLoopbackDPoPWebIdExtractor",
        "originalUrlExtractor": {
          "@id": "urn:solid-server:default:DPoPUrlExtractor"
        },
        "baseUrl": {
          "@id": "urn:solid-server:default:variable:baseUrl",
          "@type": "Variable"
        }
      }
    },
    {
      "comment": "Resolve account WebID ownership through the CSS identity stores without opening a second database connection.",
      "@id": "urn:undefineds:xpod:PodOwnershipResolver",
      "@type": "https://linkedsoftwaredependencies.org/bundles/npm/@undefineds.co/xpod/^0.0.0/dist/identity/oidc/PodOwnershipResolver.jsonld#CssPodOwnershipResolver",
      "@context": {
        "webIdStore": "https://linkedsoftwaredependencies.org/bundles/npm/@undefineds.co/xpod/^0.0.0/dist/identity/oidc/PodOwnershipResolver.jsonld#CssPodOwnershipResolver_options_webIdStore",
        "podStore": "https://linkedsoftwaredependencies.org/bundles/npm/@undefineds.co/xpod/^0.0.0/dist/identity/oidc/PodOwnershipResolver.jsonld#CssPodOwnershipResolver_options_podStore"
      },
      "webIdStore": {
        "@id": "urn:solid-server:default:WebIdStore"
      },
      "podStore": {
        "@id": "urn:solid-server:default:PodStore"
      }
    },
    {
      "comment": "Scope OIDC WebID choices to Pods known by the current storage provider.",
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:PickWebIdHandler"
      },
      "overrideParameters": {
        "@type": "ScopedPickWebIdHandler",
        "ownershipResolver": {
          "@id": "urn:undefineds:xpod:PodOwnershipResolver"
        },
        "providerFactory": {
          "@id": "urn:solid-server:default:IdentityProviderFactory"
        },
        "storageBaseUrl": {
          "@id": "urn:solid-server:default:variable:baseUrl",
          "@type": "Variable"
        },
        "provisionBaseUrl": {
          "@id": "urn:solid-server:default:variable:oidcIssuer",
          "@type": "Variable"
        }
      }
    },
    {
      "comment": "Expose exact Account WebID/storage pairs for the current Xpod storage root.",
      "@id": "urn:undefineds:xpod:AccountStorageBindingsRoute",
      "@type": "RelativePathInteractionRoute",
      "base": {
        "@id": "urn:solid-server:default:AccountIdRoute"
      },
      "relativePath": "bindings/"
    },
    {
      "@id": "urn:undefineds:xpod:AccountStorageBindingsRouter",
      "@type": "AuthorizedRouteHandler",
      "route": {
        "@id": "urn:undefineds:xpod:AccountStorageBindingsRoute"
      },
      "source": {
        "@id": "urn:undefineds:xpod:AccountStorageBindingsHandler",
        "@type": "AccountStorageBindingsHandler",
        "podStore": {
          "@id": "urn:solid-server:default:PodStore"
        },
        "storageBaseUrl": {
          "@id": "urn:solid-server:default:variable:baseUrl",
          "@type": "Variable"
        }
      }
    },
    {
      "comment": "Route the authorized bindings resource through CSS's account interaction chain.",
      "@id": "urn:solid-server:default:InteractionRouteHandler",
      "@type": "StatusWaterfallHandler",
      "handlers": [
        {
          "@id": "urn:undefineds:xpod:AccountStorageBindingsRouter"
        }
      ]
    },
    {
      "@id": "urn:solid-server:default:AccountControlHandler",
      "@type": "ControlHandler",
      "controls": [
        {
          "ControlHandler:_controls_key": "bindings",
          "ControlHandler:_controls_value": {
            "@id": "urn:undefineds:xpod:AccountStorageBindingsRoute"
          }
        }
      ]
    },
    {
      "comment": "Override main HTML template to remove CSS default header/footer wrapper.",
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:MainTemplateEngine"
      },
      "overrideParameters": {
        "@type": "StaticTemplateEngine",
        "templateEngine": { "@id": "urn:solid-server:default:TemplateEngine" },
        "template": "./templates/main.html.ejs"
      }
    },
    {
      "comment": "Expose the canonical storage URL for remotely provisioned Pods without creating a phantom Cloud Pod.",
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:PodStore"
      },
      "overrideParameters": {
        "@type": "ProvisionPodStore",
        "storage": { "@id": "urn:solid-server:default:AccountStorage" },
        "manager": { "@id": "urn:solid-server:default:PodManager" }
      }
    },
    {
      "comment": "Extend PodCreator with provisioning and reconcile the Solid storage binding after CSS creates its native Pod resources.",
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:PodCreator"
      },
      "overrideParameters": {
        "@type": "ProvisionPodCreator",
        "baseUrl": { "@id": "urn:solid-server:default:variable:baseUrl" },
        "provisionBaseUrl": {
          "@id": "urn:solid-server:default:variable:oidcIssuer",
          "@type": "Variable"
        },
        "nodeId": {
          "@id": "urn:solid-server:default:variable:nodeId",
          "@type": "Variable"
        },
        "identifierGenerator": { "@id": "urn:solid-server:default:IdentifierGenerator" },
        "relativeWebIdPath": "/profile/card#me",
        "webIdStore": { "@id": "urn:solid-server:default:WebIdStore" },
        "podStore": { "@id": "urn:solid-server:default:PodStore" },
        "resourceStore": { "@id": "urn:solid-server:default:ResourceStore" },
        "identityDbUrl": { "@id": "urn:solid-server:default:variable:identityDbUrl" }
      }
    },
    {
      "comment": "Subgraph query engine wrapping default SPARQL engine (DefaultSparqlEngine defined in profile)",
      "@type": "SubgraphQueryEngine",
      "@id": "urn:undefineds:xpod:SubgraphQueryEngine",
      "engine": {
        "@id": "urn:undefineds:xpod:DefaultSparqlEngine"
      }
    },
    {
      "comment": "Serves subgraph-scoped SPARQL endpoints",
      "@type": "SubgraphSparqlHttpHandler",
      "@id": "urn:undefineds:xpod:SubgraphSparqlHttpHandler",
      "queryEngine": {
        "@id": "urn:undefineds:xpod:SubgraphQueryEngine"
      },
      "credentialsExtractor": {
        "@id": "urn:solid-server:default:CredentialsExtractor"
      },
      "permissionReader": {
        "@id": "urn:solid-server:default:PermissionReader"
      },
      "authorizer": {
        "@id": "urn:solid-server:default:Authorizer"
      },
      "updateAuthority": {
        "@id": "urn:undefineds:xpod:MixDataAccessor"
      },
      "options_identityDbUrl": {
        "@id": "urn:solid-server:default:variable:identityDbUrl",
        "@type": "Variable"
      },
      "options_usageDbUrl": {
        "@id": "urn:solid-server:default:variable:usageDbUrl",
        "@type": "Variable"
      },
      "options_defaultAccountBandwidthLimitBps": {
        "@type": "Literal",
        "value": 0
      }
    },
    {
      "comment": "Loopback-only runtime-signed hosted Pod data channel for AI Connection resources.",
      "@type": "https://linkedsoftwaredependencies.org/bundles/npm/@undefineds.co/xpod/^0.0.0/dist/http/InternalPodDataHttpHandler.jsonld#InternalPodDataHttpHandler",
      "@id": "urn:undefineds:xpod:InternalPodDataHttpHandler",
      "@context": {
        "resourceStore": "https://linkedsoftwaredependencies.org/bundles/npm/@undefineds.co/xpod/^0.0.0/dist/http/InternalPodDataHttpHandler.jsonld#InternalPodDataHttpHandler_options_resourceStore",
        "patchBodyParser": "https://linkedsoftwaredependencies.org/bundles/npm/@undefineds.co/xpod/^0.0.0/dist/http/InternalPodDataHttpHandler.jsonld#InternalPodDataHttpHandler_options_patchBodyParser",
        "sparqlHandler": "https://linkedsoftwaredependencies.org/bundles/npm/@undefineds.co/xpod/^0.0.0/dist/http/InternalPodDataHttpHandler.jsonld#InternalPodDataHttpHandler_options_sparqlHandler",
        "baseUrl": "https://linkedsoftwaredependencies.org/bundles/npm/@undefineds.co/xpod/^0.0.0/dist/http/InternalPodDataHttpHandler.jsonld#InternalPodDataHttpHandler_options_baseUrl"
      },
      "resourceStore": {
        "@id": "urn:solid-server:default:ResourceStore"
      },
      "patchBodyParser": {
        "@id": "urn:solid-server:default:PatchBodyParser"
      },
      "sparqlHandler": {
        "@id": "urn:undefineds:xpod:SubgraphSparqlHttpHandler"
      },
      "baseUrl": {
        "@id": "urn:solid-server:default:variable:baseUrl",
        "@type": "Variable"
      }
    },
    {
      "comment": "Tracing handler for request ID and logging. Added to CSS Middleware.",
      "@id": "urn:undefineds:xpod:TracingHandler",
      "@type": "TracingHandler"
    },
    {
      "comment": "Override CSS Middleware to add TracingHandler at the beginning.",
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:Middleware"
      },
      "overrideParameters": {
        "@type": "SequenceHandler",
        "handlers": [
          { "@id": "urn:undefineds:xpod:TracingHandler" },
          { "@id": "urn:solid-server:default:ParallelMiddleware" },
          { "@id": "urn:solid-server:default:Middleware_Cors" }
        ]
      }
    }
  ]
}
